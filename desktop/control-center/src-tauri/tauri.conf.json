{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TOM Control Center",
  "version": "0.1.0",
  "identifier": "local.tom.control-center",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://127.0.0.1:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": { "windows": [{ "title": "TOM Control Center", "width": 1360, "height": 900, "minWidth": 980, "minHeight": 680, "backgroundColor": "#0a0d12" }], "security": { "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:65400 http://127.0.0.1:65401; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:" } },
  "bundle": { "active": true, "targets": ["nsis", "msi"], "icon": ["icons/tom.ico"] }
}
